                <layout-cache minwidth='260' type-h='cell' type-w='scalable' />
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
            <zone h='48334' id='17' param='vert' type-v2='layout-flow' w='98666' x='667' y='33533'>
              <zone h='40068' id='18' name='03 - Monthly Approval Trend' w='98666' x='667' y='33533'>
                <layout-cache minheight='193' minwidth='159' type-h='scalable' type-w='scalable' />
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone fixed-size='116' h='8266' id='20' is-fixed='true' type-v2='text' w='98666' x='667' y='73601'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Times New Roman'>KEY FINDINGS</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontname='Times New Roman'>Overall average approval time: </run>
                  <run bold='true' fontcolor='#000000' fontname='Times New Roman'>11.40 business days</run>
                  <run fontcolor='#000000' fontname='Times New Roman'> across </run>
                  <run bold='true' fontcolor='#000000' fontname='Times New Roman'>5,378 permits</run>
                  <run fontcolor='#000000' fontname='Times New Roman'>.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontname='Times New Roman'>Fixture permits average </run>
                  <run bold='true' fontcolor='#000000' fontname='Times New Roman'>22.55 days</run>
                  <run fontcolor='#000000' fontname='Times New Roman'>, and Paving permits average </run>
                  <run bold='true' fontcolor='#000000' fontname='Times New Roman'>18.77 days</run>
                  <run fontcolor='#000000' fontname='Times New Roman'>, compared with </run>
                  <run bold='true' fontcolor='#000000' fontname='Times New Roman'>10.89 days</run>
                  <run fontcolor='#000000' fontname='Times New Roman'> for Excavation.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontname='Times New Roman'>Excavation accounts for approximately </run>
                  <run bold='true' fontcolor='#000000' fontname='Times New Roman'>84%</run>
                  <run fontcolor='#000000' fontname='Times New Roman'> of the permit population.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontname='Times New Roman'>Monthly averages show substantial variation, but later application cohorts may be affected by the FY2026 issuance cutoff. This trend should not be interpreted as evidence of faster processing without additional analysis.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone h='17600' id='21' type-v2='text' w='98666' x='667' y='81867'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Times New Roman'>METHODOLOGY &amp; LIMITATIONS</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Times New Roman'>Source: DDOT Transportation Online Permitting System (TOPS), Construction Permit REST Layer 23.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Times New Roman'>Scope: New permits with application dates on or after October 1, 2025, issued during FY2026 (October 1, 2025 – September 30, 2026).</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Times New Roman'>Unit of analysis: One permit per distinct tracking number. Repeated location records were consolidated.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Times New Roman'>Approval duration: Business days between ApplicationDate and LastApprovalDate, excluding weekends and observed DC holidays. Same-day approvals count as zero.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Times New Roman'>Limitations: LastApprovalDate remains a provisional approval endpoint pending source-record validation. Categories with fewer than 20 permits are excluded from the category comparison but included in overall metrics.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
